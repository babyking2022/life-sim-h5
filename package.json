{
  "name": "life-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"packages/**/*.ts\" \"scripts/p3e-playable-smoke.ts\" && node scripts/check-architecture.mjs && node scripts/architecture-self-test.mjs && node scripts/p3a-benchmark-isolation.mjs && node scripts/p3c-benchmark-isolation.mjs && node scripts/p3d-barrel-isolation.mjs && node scripts/p3e-architecture-isolation.mjs && node scripts/p3e-architecture-isolation-self-test.mjs",
    "architecture:self-test": "node scripts/architecture-self-test.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "test:browser": "node scripts/browser-bigint.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build --config vite.config.ts",
    "build:p1b": "vite build --config vite.p1b.config.ts",
    "build:ui": "vite build --config vite.p1c.config.ts",
    "preview:ui": "vite preview --config vite.p1c.config.ts --host 127.0.0.1 --port 4173",
    "test:ui": "node scripts/p1c-ui-check.mjs",
    "generate:golden": "esbuild scripts/generate-p1b-golden.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/generate-p1b-golden.mjs && node .artifacts/generate-p1b-golden.mjs",
    "test:golden-browser": "node scripts/p1b-golden-browser.mjs",
    "p2a:fixtures": "esbuild scripts/p2a-generate-fixtures.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p2a-generate.mjs && node .artifacts/p2a-generate.mjs",
    "p2a:golden": "esbuild scripts/p2a-generate-golden.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p2a-golden.mjs && node .artifacts/p2a-golden.mjs",
    "test:p2a-browser": "node scripts/p2a-golden-browser.mjs",
    "p2b:fixtures": "esbuild scripts/p2b-generate-fixtures.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p2b-generate.mjs && node .artifacts/p2b-generate.mjs",
    "p2b:golden": "esbuild scripts/p2b-generate-golden.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p2b-golden.mjs && node .artifacts/p2b-golden.mjs",
    "test:p2b-browser": "node scripts/p2b-golden-browser.mjs",
    "p2c:golden": "esbuild scripts/p2c-generate-golden.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p2c-golden.mjs && node .artifacts/p2c-golden.mjs",
    "test:p2c-browser": "node scripts/p2c-golden-browser.mjs",
    "p2c:simulate": "esbuild scripts/p2c-simulate.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p2c-simulate.mjs && node .artifacts/p2c-simulate.mjs",
    "p2d:golden": "esbuild scripts/p2d-generate-golden.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p2d-golden.mjs && node .artifacts/p2d-golden.mjs",
    "test:p2d-browser": "node scripts/p2d-golden-browser.mjs",
    "p3a:golden": "esbuild scripts/p3a-generate-golden.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p3a-golden.mjs && node .artifacts/p3a-golden.mjs",
    "test:p3a-browser": "node scripts/p3a-golden-browser.mjs",
    "p3a:isolation": "node scripts/p3a-benchmark-isolation.mjs",
    "p3a:perf": "esbuild scripts/p3a-perf.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p3a-perf.mjs && node .artifacts/p3a-perf.mjs",
    "p3b:fixtures": "esbuild scripts/p3b-generate-fixtures.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p3b-fixtures.mjs && node .artifacts/p3b-fixtures.mjs",
    "p3b:golden": "esbuild scripts/p3b-generate-golden.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p3b-golden.mjs && node .artifacts/p3b-golden.mjs",
    "test:p3b-browser": "node scripts/p3b-golden-browser.mjs",
    "p3b:distribution": "esbuild scripts/p3b-distribution.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p3b-distribution.mjs && node .artifacts/p3b-distribution.mjs",
    "p3c:fixtures": "esbuild scripts/p3c-generate-fixtures.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p3c-fixtures.mjs && node .artifacts/p3c-fixtures.mjs",
    "p3c:golden": "esbuild scripts/p3c-generate-golden.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p3c-golden.mjs && node .artifacts/p3c-golden.mjs",
    "test:p3c-browser": "node scripts/p3c-golden-browser.mjs",
    "p3c:perf": "esbuild scripts/p3c-perf.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p3c-perf.mjs && node .artifacts/p3c-perf.mjs",
    "p3c:isolation": "node scripts/p3c-benchmark-isolation.mjs",
    "p3d:fixtures": "esbuild scripts/p3d-generate-fixtures.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p3d-fixtures.mjs && node .artifacts/p3d-fixtures.mjs",
    "p3d:golden": "esbuild scripts/p3d-generate-golden.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p3d-golden.mjs && node .artifacts/p3d-golden.mjs",
    "test:p3d-browser": "node scripts/p3d-golden-browser.mjs",
    "p3d:distribution": "esbuild scripts/p3d-distribution.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p3d-distribution.mjs && node .artifacts/p3d-distribution.mjs",
    "p3d:perf": "esbuild scripts/p3d-perf.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p3d-perf.mjs && node .artifacts/p3d-perf.mjs",
    "p3d:isolation": "node scripts/p3d-barrel-isolation.mjs",
    "p3e:isolation": "node scripts/p3e-architecture-isolation.mjs",
    "p3e:isolation-self-test": "node scripts/p3e-architecture-isolation-self-test.mjs",
    "p3e:playable-smoke": "esbuild scripts/p3e-playable-smoke.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p3e-playable-smoke.mjs && node .artifacts/p3e-playable-smoke.mjs",
    "p3e:browser-smoke": "vite build --config vite.p1c.config.ts && node scripts/p3e-browser-smoke.mjs",
    "verify": "tsc --noEmit -p tsconfig.json && eslint \"packages/**/*.ts\" \"scripts/p3e-playable-smoke.ts\" && node scripts/check-architecture.mjs && node scripts/architecture-self-test.mjs && vitest run --coverage && vite build --config vite.config.ts && esbuild scripts/p3e-playable-smoke.ts --bundle --platform=node --format=esm --target=node20 --outfile=.artifacts/p3e-playable-smoke.mjs && node .artifacts/p3e-playable-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "24.6.0",
    "@types/pako": "2.0.3",
    "@vitest/coverage-v8": "3.2.4",
    "axe-core": "4.10.3",
    "esbuild": "0.25.12",
    "eslint": "9.36.0",
    "playwright": "1.55.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.0",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
